{
  "name": "workffice-local-dev",
  "private": true,
  "scripts": {
    "dev": "node scripts/start-dev-terminals.js",
    "dev:docker": "docker compose up --build",
    "dev:local": "node scripts/start-dev-terminals.js",
    "dev:frontend": "npm --prefix apps/workffice-frontend start",
    "dev:backend": "node scripts/run-backend-dev.js",
